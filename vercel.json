{
  "installCommand": "npm ci",
  "buildCommand": "npx expo export --platform web --output-dir dist-web && node scripts/web-postexport.js dist-web",
  "outputDirectory": "dist-web",
  "framework": null,
  "rewrites": [
    {
      "source": "/assets/node_modules/:path*",
      "destination": "/assets/nm/:path*"
    },
    {
      "source": "/((?!_expo/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
